const allOptions: Option[] = [
  ...options,
  {
    id: "ordinary",
    name: "Residuo común",
    color: "#64748b",
    description: "Material no contaminado y no clasificado como RPBI",
  },
];

const shuffle = <T,>(items: T[]): T[] =>
  [...items].sort(() => Math.random() - 0.5);

export default function RPBIGame() {
  const [game, setGame] = useState(() => shuffle(questions));
  const [index, setIndex] = useState(0);
  const [score, setScore] = useState(0);
  const [selected, setSelected] = useState<string | null>(null);
  const [finished, setFinished] = useState(false);

  const current = game[index];
  const correctOption = allOptions.find(
    (option) => option.id === current?.correct
  );

  function answer(id: string) {
    if (selected !== null || finished) return;

    setSelected(id);

    if (id === current.correct) {
      setScore((previous) => previous + 1);
    }
  }

  function next() {
    if (index + 1 >= game.length) {
      setFinished(true);
      return;
    }

    setIndex((previous) => previous + 1);
    setSelected(null);
  }

  function restart() {
    setGame(shuffle(questions));
    setIndex(0);
    setScore(0);
    setSelected(null);
    setFinished(false);
  }

  const buttonStyle = {
    padding: "14px",
    borderRadius: "12px",
    border: "1px solid #dbe3ed",
    background: "#ffffff",
    color: "#172033",
    textAlign: "left" as const,
    cursor: "pointer",
    fontSize: "14px",
    width: "100%",
  };

  return (
    <main
      style={{
        maxWidth: 850,
        margin: "0 auto",
        padding: 20,
        fontFamily: "system-ui, sans-serif",
        color: "#172033",
      }}
    >
      <header
        style={{
          background: "#123d35",
          color: "white",
          padding: 24,
          borderRadius: 20,
          marginBottom: 20,
        }}
      >
        <div style={{ fontSize: 12, letterSpacing: 2 }}>
          SIMULADOR EDUCATIVO DE ENFERMERÍA
        </div>
        <h1 style={{ marginBottom: 8 }}>♻️ Misión RPBI</h1>
        <p style={{ margin: 0 }}>
          Identifica cada residuo y deposítalo correctamente.
        </p>
      </header>

      {!finished ? (
        <>
          <section
            style={{
              display: "flex",
              justifyContent: "space-between",
              gap: 12,
              marginBottom: 12,
              flexWrap: "wrap",
            }}
          >
            <strong>
              Pregunta {index + 1} de {game.length}
            </strong>
            <strong>⭐ Puntos: {score}</strong>
          </section>

          <div
            style={{
              height: 8,
              background: "#e2e8f0",
              borderRadius: 10,
              marginBottom: 20,
              overflow: "hidden",
            }}
          >
            <div
              style={{
                height: "100%",
                width: `${((index + 1) / game.length) * 100}%`,
                background: "#16a34a",
                transition: "width .3s",
              }}
            />
          </div>

          <section
            style={{
              border: "1px solid #e2e8f0",
              borderRadius: 18,
              padding: 24,
              marginBottom: 20,
              textAlign: "center",
              background: "#f8fafc",
            }}
          >
            <div style={{ fontSize: 76 }}>{current.image}</div>
            <h2 style={{ marginBottom: 8 }}>{current.item}</h2>
            <p>{current.context}</p>
            <p style={{ fontWeight: 600 }}>
              ¿Dónde debes depositar este residuo?
            </p>
          </section>

          <h3>Selecciona el contenedor</h3>

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
              gap: 12,
            }}
          >
            {allOptions.map((option) => {
              const isCorrect = option.id === current.correct;
              const isSelected = option.id === selected;

              let background = "#ffffff";
              let border = "1px solid #dbe3ed";

              if (selected && isCorrect) {
                background = "#dcfce7";
                border = "2px solid #16a34a";
              } else if (isSelected && !isCorrect) {
                background = "#fee2e2";
                border = "2px solid #dc2626";
              }

              return (
                <button
                  key={option.id}
                  onClick={() => answer(option.id)}
                  disabled={selected !== null}
                  style={{
                    ...buttonStyle,
                    background,
                    border,
                    opacity: selected && !isCorrect && !isSelected ? 0.65 : 1,
                    cursor: selected ? "default" : "pointer",
                  }}
                >
                  <div
                    style={{
                      display: "flex",
                      gap: 12,
                      alignItems: "center",
                    }}
                  >
                    <div
                      style={{
                        width: 40,
                        height: 48,
                        borderRadius: 8,
                        flexShrink: 0,
                        background: option.color,
                        border: "2px solid #ffffff",
                        boxShadow: "0 0 0 1px #cbd5e1",
                      }}
                    />
                    <div>
                      <strong>{option.name}</strong>
                      <div
                        style={{
                          fontSize: 12,
                          color: "#64748b",
                          marginTop: 4,
                        }}
                      >
                        {option.description}
                      </div>
                    </div>
                  </div>
                </button>
              );
            })}
          </div>

          {selected !== null && (
            <section
              aria-live="polite"
              style={{
                marginTop: 20,
                padding: 18,
                borderRadius: 14,
                background:
                  selected === current.correct ? "#dcfce7" : "#fef3c7",
                border: "1px solid #d1d5db",
              }}
            >
              <h3 style={{ marginTop: 0 }}>
                {selected === current.correct
                  ? "✅ ¡Correcto!"
                  : "📘 Sigue aprendiendo"}
              </h3>
              <p>
                <strong>Clasificación:</strong>{" "}
                {correctOption?.name ?? "Residuo común"}
              </p>
              <p>{current.explanation}</p>
              <button
                onClick={next}
                style={{
                  background: "#123d35",
                  color: "white",
                  border: 0,
                  padding: "12px 20px",
                  borderRadius: 10,
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                {index + 1 === game.length
                  ? "Ver resultado"
                  : "Siguiente residuo →"}
              </button>
            </section>
          )}
        </>
      ) : (
        <section
          style={{
            padding: 28,
            borderRadius: 20,
            border: "1px solid #dbe3ed",
            textAlign: "center",
          }}
        >
          <div style={{ fontSize: 64 }}>
            {score >= 8 ? "🏆" : score >= 6 ? "👏" : "📚"}
          </div>
          <h2>¡Misión completada!</h2>
          <p>
            Obtuviste <strong>{score} de {game.length}</strong> respuestas
            correctas.
          </p>
          <p style={{ fontSize: 32, fontWeight: 800 }}>
            {Math.round((score / game.length) * 100)}%
          </p>
          <p>
            {score >= 8
              ? "Excelente trabajo. Continúa aplicando las normas de bioseguridad."
              : "Repasa los tipos de RPBI y vuelve a intentarlo."}
          </p>
          <button
            onClick={restart}
            style={{
              background: "#123d35",
              color: "white",
              border: 0,
              padding: "14px 22px",
              borderRadius: 10,
              fontWeight: 700,
              cursor: "pointer",
            }}
          >
            🔄 Jugar de nuevo
          </button>
        </section>
      )}

      <footer
        style={{
          marginTop: 24,
          padding: 14,
          background: "#f1f5f9",
          borderRadius: 12,
          fontSize: 12,
          color: "#475569",
        }}
      >
        Material educativo basado en la NOM-087-ECOL-SSA1-2002.
        Verifica los protocolos institucionales vigentes. Las imágenes
        representadas con emojis son ilustrativas.
      </footer>
    </main>
  );
}
